# systemd service unit for revenant-daemon.
#
# Installed to: /usr/lib/systemd/system/revenant-daemon.service
#
# Started on demand via D-Bus activation (see dev.sniner.Revenant.service).

[Unit]
Description=Revenant snapshot management daemon
Documentation=https://github.com/sniner/revenant
# Bus is required because we are dbus-activated.
Requires=dbus.socket
After=dbus.socket
# We touch the btrfs toplevel; make sure /run is up.
After=systemd-tmpfiles-setup.service

[Service]
Type=dbus
BusName=dev.sniner.Revenant
ExecStart=/usr/bin/revenantd
# Allow sd_notify(STATUS=…) so `systemctl status` reflects the
# daemon's current state ("ready, version x.y.z" or "degraded: …").
NotifyAccess=main
# RuntimeDirectory= creates /run/revenant/ owned by the service and
# cleans it up at stop. 0700 matches the mode the daemon itself
# enforces on the dir.
RuntimeDirectory=revenant
RuntimeDirectoryMode=0700
# Hardening: deliberately *no* mount-namespace-creating directives
# (ProtectSystem=, ProtectHome=, ReadWritePaths=, BindPaths=,
# PrivateMounts=, MountFlags=). The daemon publishes per-snapshot
# read-only mounts under /run/user/<uid>/ for the GUI's file
# manager; any of those directives would put the daemon into its
# own mount namespace whose mounts propagate to the host only
# through a slave relationship that the kernel does not back-
# propagate. With CAP_SYS_ADMIN already in the bounding set, the
# path-protection primitives offer mostly cosmetic defence-in-
# depth — a compromised daemon could mount over them anyway.
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=mnt
# CAP_SYS_ADMIN  : btrfs ioctls + mount(2).
# CAP_DAC_OVERRIDE: traverse into /run/user/<uid>/ (mode 0700, owner
#                   <uid>) to create the per-snapshot mount tree
#                   there; without it, uid 0 cannot enter another
#                   user's XDG runtime dir.
# CAP_CHOWN      : chown the created mount-tree dirs to the calling
#                   user so their file manager owns them.
# Everything else is dropped.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN

[Install]
# Not enabled by default — D-Bus activation handles startup.
# Listed here so distros that prefer manual enabling can do so.
WantedBy=multi-user.target
